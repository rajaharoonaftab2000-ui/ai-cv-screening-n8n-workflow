        "jsCode": "const binaryData = await this.helpers.getBinaryDataBuffer(0, 'CV');\nconst base64 = binaryData.toString('base64');\n\nreturn {\n  json: {\n    name: $json['Full Name'],\n    email: $json['Email'],\n    pdfBase64: base64\n  }\n};"
      },
