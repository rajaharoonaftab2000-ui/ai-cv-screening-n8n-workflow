      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=Your_api_key",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [\n      { \"text\": \"You are screening a job application for a Customer Support Representative position. Job requirements: at least 1 year of customer service experience, good communication skills in Urdu and English, comfortable using computers and messaging apps.\\n\\nRead the attached CV and evaluate the candidate against these requirements. Respond ONLY in this exact format:\\nScore: <a number from 0 to 100>\\nFeedback: <2-3 sentence explanation of the score>\" },\n      { \"inline_data\": { \"mime_type\": \"application/pdf\", \"data\": \"{{ $json.pdfBase64 }}\" } }\n    ]\n  }]\n}",
        "options": {}
      },
